# Salin file ini menjadi .env lalu sesuaikan isinya. Jangan commit file .env!

# Wajib diisi string acak panjang. Contoh membuat:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-panjang

# Koneksi database (pilih salah satu)
# PostgreSQL:
DATABASE_URL=postgresql+psycopg2://ecommerce_user:password_db@127.0.0.1:5432/db_ecommerce
# MySQL / MariaDB (XAMPP, Laragon):
# DATABASE_URL=mysql+pymysql://root:password_db@127.0.0.1:3306/db_ecommerce

# Nama toko yang tampil di halaman
APP_NAME=Elektronik Store

# Checkout (nilai di bawah masih contoh/dummy, ganti dengan data toko asli)
ONGKIR_FLAT=15000
TOKO_ALAMAT=Jl. Ahmad Yani, Batam Centre, Kota Batam
TOKO_JAM_BUKA=Senin-Sabtu, 09.00-20.00 WIB
BANK_NAMA=BCA
BANK_NOREK=1234567890
BANK_ATAS_NAMA=Elektronik Store

# Isi 1 jika aplikasi dijalankan di belakang reverse proxy (Nginx) agar IP asli klien tercatat di log
TRUST_PROXY=0

# Isi 1 jika sudah memakai HTTPS (cookie sesi hanya dikirim lewat HTTPS)
SESSION_COOKIE_SECURE=0

# Lokasi file log keamanan (dibaca oleh Wazuh agent)
SECURITY_LOG_FILE=logs/security.log
