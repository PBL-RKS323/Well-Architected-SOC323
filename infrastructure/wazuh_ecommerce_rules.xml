<!-- Wazuh Custom Rules for SOC 323 E-Commerce Application -->
<!-- Disusun oleh tim Keamanan Siber (Ihsan Alfareno) -->
<group name="ecommerce,soc323,">
  <rule id="100200" level="3">
    <description>E-Commerce application activity log</description>
  </rule>

  <rule id="100201" level="5">
    <if_sid>100200</if_sid>
    <match>FAILED_LOGIN</match>
    <description>E-Commerce: Percobaan autentikasi gagal</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <rule id="100202" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100201</if_matched_sid>
    <same_source_ip />
    <description>E-Commerce: Percobaan brute-force login terdeteksi dari alamat IP yang sama</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100203" level="8">
    <if_sid>100200</if_sid>
    <match>CSRF_FAILURE</match>
    <description>E-Commerce: Pelanggaran token proteksi CSRF terdeteksi</description>
    <mitre>
      <id>T1557</id>
    </mitre>
  </rule>

  <rule id="100204" level="7">
    <if_sid>100200</if_sid>
    <match>UPLOAD_REJECTED</match>
    <description>E-Commerce: Upaya unggah file ditolak oleh filter keamanan biner</description>
  </rule>
</group>
